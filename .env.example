# AstrBot Brasil - exemplo de variáveis de ambiente
# Copie para .env somente se sua forma de execução carregar esse arquivo.
# NUNCA coloque credenciais reais neste arquivo versionado.

# 1 desativa métricas anônimas; 0 mantém o comportamento padrão do projeto.
ASTRBOT_DISABLE_METRICS=0

# Senha inicial opcional do dashboard.
# Defina apenas no seu ambiente local ou em um secret do serviço de deploy.
# ASTRBOT_DASHBOARD_INITIAL_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Porta opcional do dashboard.
# DASHBOARD_PORT=6185

# Exemplo de proxy HTTP/HTTPS, caso sua rede exija.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# As API keys dos provedores de IA devem ser cadastradas na configuração
# apropriada e nunca commitadas no repositório.
