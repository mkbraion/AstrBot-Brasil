# AstrBot Brasil - política de finais de linha
# Mantém arquivos de código com LF para evitar alterações artificiais entre
# Windows, Linux e macOS. Scripts PowerShell usam CRLF no checkout do Windows.
* text=auto

*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.zip binary
*.pdf binary
